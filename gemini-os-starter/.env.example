# ============================================
# GEMINI OS - Environment Variables
# ============================================

# ---------------------------------------------
# CLIENT-SIDE (Vite - exposed to browser)
# ---------------------------------------------
# Prefix with VITE_ to expose to the client (only use for non-sensitive values)

# Google Gemini API Key for AI story generation
GEMINI_API_KEY=your_gemini_api_key_here
# Or use VITE_ prefix if you want it available in browser
# VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------
# SERVER-SIDE (Cloudflare Workers)
# ---------------------------------------------
# These are NOT exposed to the browser
# Set these in Cloudflare Dashboard → Workers → Settings → Variables

# FAL.ai API Key (for image/sprite/audio generation)
# SECURITY: Keep this server-side only via /api/fal-proxy
FAL_KEY=your_fal_api_key_here

# Upstash Redis REST URL (serverless Redis for sessions & analytics)
# Get from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io

# Upstash Redis REST Token
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ---------------------------------------------
# CLOUDFLARE KV NAMESPACE IDs
# ---------------------------------------------
# Create these in Cloudflare Dashboard → Workers → KV
# Then replace the placeholders in wrangler.toml

# Production KV Namespaces:
# - SPRITE_CACHE: For generated sprites (7-day cache)
# - ROOM_CACHE: For generated rooms (24-hour cache)
# - AUDIO_CACHE: For TTS/music URLs (30-min cache)

# Create KV namespaces by running:
# wrangler kv:namespace create "SPRITE_CACHE"
# wrangler kv:namespace create "ROOM_CACHE"
# wrangler kv:namespace create "AUDIO_CACHE"

# Development KV Namespaces (for local testing):
# wrangler kv:namespace create "SPRITE_CACHE" --preview
# wrangler kv:namespace create "ROOM_CACHE" --preview
# wrangler kv:namespace create "AUDIO_CACHE" --preview

# ---------------------------------------------
# OPTIONAL: Other API Keys
# ---------------------------------------------
# These may be used if you enable additional features

# ElevenLabs API Key (if using ElevenLabs TTS instead of FAL)
# ELEVENLABS_API_KEY=your_elevenlabs_key_here

# ---------------------------------------------
# DEPLOYMENT NOTES
# ---------------------------------------------
# 1. Copy this file to .env for local development
# 2. NEVER commit .env to git (it's in .gitignore)
# 3. Set Worker environment variables in Cloudflare Dashboard
# 4. Update wrangler.toml with actual KV namespace IDs after creation
# 5. For production, use Cloudflare secrets for sensitive values:
#    wrangler secret put FAL_KEY
#    wrangler secret put UPSTASH_REDIS_REST_TOKEN
